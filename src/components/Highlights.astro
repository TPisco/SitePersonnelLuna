---
import Sticker from './Sticker.astro';
import type { Dict } from '../i18n';

// Short band of proof points for bookers and press (text in src/i18n/*.json → highlights).
interface Props {
  t: Dict;
}

const { t } = Astro.props;
---

<section class="section surface-purple highlights" id="highlights" aria-labelledby="highlights-title" data-section>
  <Sticker kind="sparkle" color="yellow" size={48} motion="spin" class="highlights__sparkle" />
  <Sticker kind="dot" color="orange" size={22} class="highlights__dot" />

  <div class="container">
    <h2 id="highlights-title" class="eyebrow highlights__title" data-reveal>{t.highlights.title}</h2>
    <ul role="list" class="highlights__list">
      {
        t.highlights.items.map((item) => (
          <li class="highlight" data-reveal>
            <p class="highlight__value display">{item.value}</p>
            <p class="highlight__label">{item.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .highlights {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }
  .highlights__sparkle {
    top: clamp(1.5rem, 4vw, 3rem);
    right: 7vw;
  }
  .highlights__dot {
    bottom: clamp(1.5rem, 4vw, 3rem);
    left: 4vw;
  }

  .highlights__title {
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--lavender);
  }

  .highlights__list {
    display: grid;
    gap: 1.75rem 2rem;
  }

  .highlight {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding-top: 1.1rem;
    border-top: 2px solid rgb(186 148 207 / 0.55);
  }
  .highlight__value {
    font-size: clamp(2.75rem, 7vw, 4.25rem);
    line-height: 0.9;
    text-shadow: 0.05em 0.05em 0 var(--magenta);
    overflow-wrap: anywhere;
  }
  .highlight__label {
    max-width: 30ch;
    color: var(--lavender);
    font-size: 0.975rem;
    line-height: 1.4;
  }

  @media (min-width: 640px) {
    .highlights__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .highlights__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .highlight__value {
      font-size: clamp(2.75rem, 4.4vw, 4.25rem);
    }
  }
</style>
