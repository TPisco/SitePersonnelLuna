---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import Sticker from './Sticker.astro';
import site from '../data/site.json';
import { photo } from '../lib/assets';
import { fill, type Dict } from '../i18n';

interface Props {
  t: Dict;
}

const { t } = Astro.props;

// Art direction: wide photo (extended with Higgsfield outpaint) on landscape screens,
// the original square portrait on phones and portrait tablets.
const wide = photo('hero-wide');
const square = photo('purple-door-square');

async function srcset(src: ImageMetadata, widths: number[], format: 'avif' | 'webp', quality: number) {
  const images = await Promise.all(widths.map((width) => getImage({ src, width, format, quality })));
  return images.map((img, i) => `${img.src} ${widths[i]}w`).join(', ');
}

const wideWidths = [1280, 1680, 2200, 2752];
const squareWidths = [640, 960, 1280, 1600];
const [wideAvif, wideWebp, squareAvif, squareWebp, fallback] = await Promise.all([
  srcset(wide, wideWidths, 'avif', 55),
  srcset(wide, wideWidths, 'webp', 72),
  srcset(square, squareWidths, 'avif', 55),
  srcset(square, squareWidths, 'webp', 72),
  getImage({ src: square, width: 960, format: 'jpg', quality: 75 }),
]);

const landscape = '(min-width: 900px) and (min-aspect-ratio: 1/1)';
const links = [...site.streaming, ...site.socials];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <picture class="hero__media">
    <source media={landscape} type="image/avif" srcset={wideAvif} sizes="100vw" />
    <source media={landscape} type="image/webp" srcset={wideWebp} sizes="100vw" />
    <source type="image/avif" srcset={squareAvif} sizes="max(100vw, 100vh)" />
    <source type="image/webp" srcset={squareWebp} sizes="max(100vw, 100vh)" />
    <img src={fallback.src} width="1536" height="1536" alt={t.hero.photoAlt} fetchpriority="high" />
  </picture>
  <div class="hero__shade" aria-hidden="true"></div>

  <Sticker kind="star" color="yellow" size={120} motion="float" class="hero__star" />
  <Sticker kind="dot" color="orange" size={72} class="hero__dot" />
  <Sticker kind="dot" color="offwhite" size={18} class="hero__dot-small" />

  <div class="hero__content container">
    <p class="hero__eyebrow eyebrow">
      {t.hero.eyebrow}<span class="hero__sep" aria-hidden="true">✦</span>{t.hero.origin}
    </p>
    <h1 id="hero-title" class="hero__name display">{site.name}</h1>

    <div class="hero__row">
      <p class="hero__tagline" lang={t.hero.taglineLang}>{t.hero.tagline}</p>

      <div class="hero__actions">
        <a class="btn btn--magenta" href="#music">
          <Icon name="play" />
          {t.hero.listen}
        </a>
        <a class="btn btn--outline" href={site.latestRelease.url} target="_blank" rel="noopener">
          {fill(t.hero.latest, { title: site.latestRelease.title })}
          <Icon name="arrow-up-right" />
          <span class="sr-only">{t.a11y.newTab}</span>
        </a>
      </div>

      <ul role="list" class="hero__icons" aria-label={t.a11y.platforms}>
        {
          links.map((link) => (
            <li>
              <a class="icon-btn" href={link.url} target="_blank" rel="noopener">
                <Icon name={link.id} />
                <span class="sr-only">
                  {link.label} {t.a11y.newTab}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: 100vh;
    min-height: 100svh;
    padding-top: var(--header-h);
    overflow: clip;
    color: var(--offwhite);
    background: var(--purple);
    --focus: var(--yellow);
  }

  .hero__media,
  .hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }
  .hero__media img {
    object-fit: cover;
    object-position: 50% 22%;
  }

  /* Purple shade: keeps the name and buttons readable (AA) over the photo. */
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, rgb(65 33 83 / 0.7) 0%, rgb(65 33 83 / 0) 22%),
      linear-gradient(to top, rgb(65 33 83 / 0.97) 0%, rgb(65 33 83 / 0.85) 30%, rgb(65 33 83 / 0.2) 60%, rgb(65 33 83 / 0) 72%);
  }

  .hero__star {
    top: calc(var(--header-h) + 5vh);
    right: 6vw;
    width: clamp(64px, 10vw, 140px);
    height: auto;
    rotate: 12deg;
  }
  .hero__dot {
    top: 22%;
    left: 5vw;
    width: clamp(40px, 6vw, 84px);
    height: auto;
  }
  .hero__dot-small {
    top: 30%;
    right: 22vw;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    padding-bottom: clamp(1.5rem, 5vh, 3.25rem);
  }

  .hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    color: var(--offwhite);
  }
  .hero__sep {
    color: var(--yellow);
  }

  .hero__name {
    margin: 0.08em 0 0.1em -0.03em;
    font-size: clamp(5.25rem, 25vw, 21rem);
    line-height: 0.82;
    letter-spacing: 0.01em;
    text-shadow: 0.035em 0.035em 0 var(--magenta);
  }

  .hero__row {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(0.75rem, 2vh, 1.5rem);
  }

  .hero__tagline {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-style: italic;
    font-weight: 600;
    line-height: 1.2;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__icons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (min-width: 900px) {
    .hero__row {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 2rem;
    }
    .hero__actions {
      justify-content: center;
    }
  }
</style>
